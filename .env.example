POSTGRES_USER=italian
POSTGRES_PASSWORD=italian
POSTGRES_DB=italian_school
# Адрес БД для локального запуска (manage.py runserver).
# В контейнере web он переопределяется на db:5432 в docker-compose.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
